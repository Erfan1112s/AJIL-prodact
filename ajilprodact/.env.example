# Database (production credentials must be provisioned by the host)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Public HTTPS origin used for payment return redirects
NEXT_PUBLIC_BASE_URL=https://shop.example.com

# Select the configured payment gateway: zarinpal or tikart.
# TiKart remains disabled until its official API contract is verified.
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# Required session-signing secrets (use independent random values, 32+ chars)
ADMIN_SESSION_SECRET=
CUSTOMER_SESSION_SECRET=

# Optional external services
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_ORDER_TEMPLATE_ID=
SHAHKAR_API_URL=
SHAHKAR_API_KEY=
